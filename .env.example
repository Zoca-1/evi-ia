# Copia este archivo como .env y completa los valores. NUNCA subas el .env real.
# EVI.IA no necesita claves de API para funcionar: el scraping es público y
# el respaldo es un CSV local.

# --- Scraping del estudio de mercado ---
# true/false: intentar scraping en vivo antes de usar data/inmuebles_respaldo.csv
SCRAPER_ENABLED=true
# Segundos de pausa entre requests (time.sleep), para no saturar los portales
SCRAPER_DELAY_SECONDS=2
# Timeout por request (segundos)
SCRAPER_TIMEOUT_SECONDS=6
# Tipo de cambio para convertir avisos publicados solo en soles
TIPO_CAMBIO=3.75
# User-Agent identificable del scraper (pon un contacto del proyecto)
SCRAPER_USER_AGENT=

# --- Reservado para futuras integraciones (vacío = desactivado) ---
ANTHROPIC_API_KEY=
