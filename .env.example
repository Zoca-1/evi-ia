# Copia este archivo como .env y completa los valores. NUNCA subas el .env real.
# EVI.IA no necesita claves de API: la app lee data/inmuebles_respaldo.csv y el
# refresco lo hace scripts/actualizar_dataset_real.py (páginas públicas).

# --- App ---
# true/false: mostrar el botón "Actualizar dataset" en la barra lateral
PERMITIR_ACTUALIZAR_DATASET=true

# --- Script de actualización (scripts/actualizar_dataset_real.py) ---
# Timeout por request (segundos)
SCRAPER_TIMEOUT_SECONDS=15
# Tipo de cambio para convertir avisos publicados solo en soles
TIPO_CAMBIO=3.75
# User-Agent honesto e identificable del scraper (opcional: añade un contacto del proyecto)
SCRAPER_USER_AGENT=

# --- Reservado para futuras integraciones (vacío = desactivado) ---
ANTHROPIC_API_KEY=
